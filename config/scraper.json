{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutSec": 10,
  "pageDelaySec": 1.0,
  "retry": {
    "maxAttempts": 5,
    "baseDelaySec": 2.0,
    "maxDelaySec": 60.0,
    "retryStatus": [429, 500, 502, 503, 504]
  },
  "staleJobDeletion": false,
  "manageCompany": true,
  "defaultLocation": ["Cluj-Napoca"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://www.betfairromania.ro/jobs/",
  "sources": {
    "sitemap": "",
    "listing": "https://www.betfairromania.ro/jobs",
    "jobArchive": "https://www.betfairromania.ro/jobs/"
  },
  "selectors": {
    "jobArticle": [".card-job", "[class*='job']", ".vacancy, .position, .listing-item"],
    "jobTitle": ["", "h1, h2, h3, h4", "[itemprop='title'], [aria-label]", "a"],
    "jobMeta": ["", "p, .meta, [class*='deadline']"]
  }
}
